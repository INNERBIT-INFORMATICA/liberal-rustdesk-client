# Branding preset for Liberal Contabilidade. Sourced by scripts/build-client.sh.
# KEY is the hbbs *public* key (id_ed25519.pub) - not a secret.
# TODO: KEY - the provided key has 43 chars (invalid base64, ed25519 needs 44).
SERVER="remote.liberalcontabilidade.com.br"
KEY="TODO"
FILENAME="liberal-suporte"
APPNAME="Liberal Contabilidade"
COMPNAME="Liberal Contabilidade"
# Brand color as RRGGBB (empty = RustDesk default blue)
ACCENT_COLOR="0C3249"
# Optional overrides: REPO, VERSION, EXTRA_ARGS=(--flag value ...)
